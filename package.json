{
  "name": "python-project-statistics",
  "displayName": "aicount",
  "publisher": "chaitanyarajuBahatam",
  "description": "Counts files and lines by file type in your workspace",
  "version": "0.0.6",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "poc.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "poc.projectStatistics",
        "title": "Project Statistics"
      },
      {
        "command": "poc.refreshSidebar",
        "title": "Refresh Statistics",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aicount",
          "title": "aicount",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "aicount": [
        {
          "type": "webview",
          "id": "aicount.sidebar",
          "name": "Project Statistics"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "poc.refreshSidebar",
          "when": "view == aicount.sidebar",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
